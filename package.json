{
  "name": "finance-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "app:worker:dev": "wrangler dev --config workers/app/wrangler.jsonc",
    "app:worker:check": "wrangler deploy --dry-run --config workers/app/wrangler.jsonc",
    "app:worker:deploy": "bun run build && wrangler deploy --config workers/app/wrangler.jsonc",
    "mcp:stdio": "bun run scripts/mcp-stdio.ts",
    "mcp:worker:dev": "wrangler dev --config workers/mcp/wrangler.jsonc",
    "mcp:worker:check": "wrangler deploy --dry-run --config workers/mcp/wrangler.jsonc",
    "mcp:worker:deploy": "wrangler deploy --config workers/mcp/wrangler.jsonc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preflight": "bun run typecheck && bun run lint && bun run format:check && bun run test:run",
    "prepare": "husky",
    "supabase:types": "supabase gen types typescript --project-id vbeevkjenvgvnattzszt --schema public > src/types/database.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:pull": "supabase db pull",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "db:new": "supabase migration new",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "db:types:local": "supabase gen types typescript --local --schema public > src/types/database.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.46.1",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-table": "^8.20.6",
    "@types/papaparse": "^5.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dinero.js": "2.0.0-alpha.14",
    "jose": "^6.2.10",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "nuqs": "^2.3.2",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@eslint/js": "^9.17.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/dinero.js": "^1.9.4",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-tailwindcss": "3.18.3",
    "eslint-plugin-unicorn": "64.0.0",
    "globals": "^15.14.0",
    "happy-dom": "20.9.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.4",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "4.1.6",
    "wrangler": "^4.127.1"
  }
}
